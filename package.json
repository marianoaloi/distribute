{
  "name": "distribute",
  "version": "2.0.79",
  "private": true,
  "main": "electron-dist/app.js",
  "homepage": "./",
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.2",
    "@mui/material": "^6.1.2",
    "@reduxjs/toolkit": "^2.11.2",
    "better-sqlite3": "^11.10.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-is-dev": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "jimp": "^1.6.1",
    "mime-types": "^2.1.35",
    "onnxruntime-node": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.0.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "overrides": {
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.25.7",
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^27.5.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^16.18.112",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/redux-logger": "3.0.9",
    "electron": "^31.0.1",
    "electron-builder": "^26.8.1",
    "redux-logger": "^3.0.6",
    "typescript": "^4.9.5"
  },
  "build": {
    "appId": "com.maloi.distribute",
    "productName": "distribute",
    "directories": {
      "output": "../distribute-dist"
    },
    "files": [
      "build/**/*",
      "electron-dist/**/*",
      "menu.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/better-sqlite3/**",
      "node_modules/onnxruntime-node/**"
    ],
    "extraMetadata": {
      "main": "electron-dist/app.js"
    },
    "icon": "public/logo512.png",
    "win": {
      "target": "portable"
    }
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -o better-sqlite3",
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json -w",
    "prestartele": "npm run build:electron",
    "startele": "nodemon -e js --watch electron-dist --exec electron . ",
    "start": "react-scripts start --no-browser  --source-map --base-href ",
    "build": "react-scripts build",
    "buildMaloi": "react-scripts build --source-map --base-href ",
    "test": "react-scripts test",
    "preelectron": "npm run build:electron",
    "electron": "npm version patch --no-git-tag-version && electron .",
    "eject": "react-scripts eject",
    "buildele": "npm run build && npm run build:electron && ./ExecutableLinux.sh",
    "deb64": "electron-installer-debian --src dist_resume/getimage-linux-x64/ --dest dist_resume/installers/ --arch amd64",
    "execWindows": "react-scripts build && npm run build:electron && electron-builder --win --x64 --publish never"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
